# Copier en .env (ou lancer deploy/scripts/init.sh, qui génère les secrets).
# Ne jamais versionner le fichier .env.

# --- Secrets (générés par init.sh) ---
DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
VALKEY_PASSWORD=
APISIX_ADMIN_KEY=
ADMIN_API_TOKEN=
USAGE_INGEST_TOKEN=
RABBITMQ_PASSWORD=
# Compte de service du back-end dans Keycloak (gestion des accès)
KEYCLOAK_BACKEND_SECRET=
# Secret partagé avec SMT Cockpit (signature HMAC des ordres et des webhooks)
COCKPIT_SHARED_SECRET=

# --- Réglages ---
KEYCLOAK_ADMIN_USER=admin
# Adresse de Keycloak vue par les navigateurs (émetteur des jetons). En production : https://auth.<domaine>
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Port de la passerelle exposé aux banques
GATEWAY_PORT=9080
# Portail des banques et console SMT (la console n'écoute que sur 127.0.0.1)
PORTAIL_PORT=5174
CONSOLE_PORT=5173
# Environnement servi par cette passerelle : SANDBOX (simulateurs) ou PRODUCTION
GATEWAY_ENVIRONMENT=SANDBOX
# Réconciliation complète back-end -> APISIX, en secondes (0 = désactivée)
GATEWAY_SYNC_INTERVAL_SECONDS=300
VALKEY_KEY_PREFIX=apigw
# Pas de production sans mise en service validée (PV signé banque + SMT)
ONBOARDING_ENFORCE=true
# Lot 1 uniquement : schéma créé automatiquement. Passer à false avec les migrations.
DB_SYNCHRONIZE=true

# --- Couche d'intégration (vide = simulateurs de la sandbox) ---
# Plateforme Chargeback (ISO 8583 sur TCP)
CHARGEBACK_HOST=
CHARGEBACK_PORT=8583
# SMT Cockpit (API HTTP des ordres)
COCKPIT_URL=
# Services opérationnels en lecture (en production : routes APISIX de chaque fournisseur)
OPS_SVIP_URL=
OPS_P1_URL=
OPS_COCKPIT_URL=
# Clé de consommateur APISIX du back-end, si les routes l'exigent
OPS_API_KEY=
