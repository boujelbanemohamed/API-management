# Copier en .env (ou lancer deploy/scripts/init.sh, qui génère les secrets).
# Ne jamais versionner le fichier .env.

# --- Secrets (générés par init.sh) ---
DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
VALKEY_PASSWORD=
APISIX_ADMIN_KEY=
ADMIN_API_TOKEN=
USAGE_INGEST_TOKEN=

# --- Réglages ---
KEYCLOAK_ADMIN_USER=admin
# Adresse de Keycloak vue par les navigateurs (émetteur des jetons). En production : https://auth.<domaine>
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Port de la passerelle exposé aux banques
GATEWAY_PORT=9080
# Environnement servi par cette passerelle : SANDBOX (simulateurs) ou PRODUCTION
GATEWAY_ENVIRONMENT=SANDBOX
# Réconciliation complète back-end -> APISIX, en secondes (0 = désactivée)
GATEWAY_SYNC_INTERVAL_SECONDS=300
VALKEY_KEY_PREFIX=apigw
# Pas de production sans mise en service validée (PV signé banque + SMT)
ONBOARDING_ENFORCE=true
# Lot 1 uniquement : schéma créé automatiquement. Passer à false avec les migrations.
DB_SYNCHRONIZE=true
