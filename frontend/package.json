{
  "name": "api-platform-frontend",
  "private": true,
  "workspaces": [
    "ui",
    "portail",
    "console"
  ],
  "scripts": {
    "dev:portail": "npm run dev -w portail",
    "dev:console": "npm run dev -w console",
    "build": "npm run build -w portail && npm run build -w console",
    "test": "npm run test -w ui -w portail -w console",
    "typecheck": "tsc -p portail && tsc -p console"
  },
  "dependencies": {
